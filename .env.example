# Run python scripts/configure.py to generate local secrets. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql+psycopg://clientflow:replace-with-a-random-password@db:5432/clientflow
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD_HASH=generate-with-scripts-configure.py
AUTOMATION_SECRET=replace-with-at-least-32-random-characters
N8N_ENCRYPTION_KEY=replace-with-a-random-key
WEB_PORT=3010
API_PORT=8010
PUBLIC_ORIGIN=http://localhost:3010
COOKIE_SECURE=false
ORCHESTRATION_MODE=app
LOG_LEVEL=INFO
# Networks allowed to assert a client address for per-client rate limiting.
# Compose sets this for its private network. Leave empty when the API is reached
# directly, so no caller-supplied address is ever trusted.
TRUSTED_PROXY_CIDRS=
CLIENT_IP_HEADER=x-forwarded-for
# Set to true only when a reverse proxy in front of the web service overwrites
# X-Forwarded-For. Left false, per-client rate limiting is off and only the
# global backstop and per-email limits apply, which is the safe default.
TRUST_UPSTREAM_FORWARDED_FOR=false
LLM_PROVIDER=mock
CRM_PROVIDER=internal
EMAIL_PROVIDER=mock
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
HUBSPOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
