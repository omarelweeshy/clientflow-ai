    {
      "id": "077c4922-0e45-40e7-9a19-b1c5be3c44d6",
      "name": "Scheduled polling",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        160
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "2e451d2a-14b3-4c0e-ab3f-9a1cc79391d6",
      "name": "Call protected business API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLIENTFLOW_API_URL + '/automation/crm/tick' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.AUTOMATION_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "dcfd4bec-bd03-4ab3-97e7-3831f8968569",
      "name": "Integration error \u00b7 inspect execution",
      "type": "n8n-nodes-base.stopAndError",
