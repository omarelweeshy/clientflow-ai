{
  "id": "clientflow02",
  "name": "ClientFlow \u00b7 CRM synchronization",
  "active": false,
  "nodes": [
    {
      "id": "31b737bf-93a4-4a89-9a85-13ed5e3c6e06",
      "name": "Manual demo run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "fa4ebeb7-a274-4834-a6e2-edd7ef1d732c",
      "name": "Scheduled polling",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        160
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "4285c87d-98cf-4b42-9df6-0621d3112b32",
      "name": "Call protected business API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLIENTFLOW_API_URL + '/automation/crm/tick' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.AUTOMATION_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "462d9fdb-cc7e-40da-936f-aa6ef5ba73cc",
      "name": "Integration error \u00b7 inspect execution",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        720,
        220
      ],
      "parameters": {
        "errorMessage": "ClientFlow API request failed. Inspect service health and the automation ledger before retrying."
      }
    },
    {
      "id": "61c9f96e-8c87-420f-afa8-223cfae70fe9",
      "name": "Business outcome recorded in PostgreSQL",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {}
    },
    {
