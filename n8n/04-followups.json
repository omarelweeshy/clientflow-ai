{
  "id": "clientflow04",
  "name": "ClientFlow \u00b7 Follow-up stop checks",
  "active": false,
  "nodes": [
    {
      "id": "5e5f5700-8002-4ca5-98d5-6382476d7430",
      "name": "Manual demo run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "fcfe6618-b02c-4745-ae28-8a9c1fc7e50d",
      "name": "Scheduled polling",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        160
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "e046d620-2e36-485b-be16-523abe459bca",
      "name": "Call protected business API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLIENTFLOW_API_URL + '/automation/followups/tick' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.AUTOMATION_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "ef9b0f70-9cf9-42f5-9b9d-cf9657a1aa5b",
      "name": "Integration error \u00b7 inspect execution",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        720,
        220
      ],
      "parameters": {
        "errorMessage": "ClientFlow API request failed. Inspect service health and the automation ledger before retrying."
      }
    },
    {
      "id": "565477d8-891f-4d1e-ba9d-68e323d57b17",
      "name": "Business outcome recorded in PostgreSQL",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {}
    },
    {
      "id": "acd8e958-5819-474f-a312-f52f56a92b15",
      "name": "Read me \u00b7 no credentials in exports",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -340
      ],
      "parameters": {
        "content": "## ClientFlow \u00b7 Follow-up stop checks\nThe API owns state, locks, retries, consent and approval.\nSet CLIENTFLOW_API_URL and AUTOMATION_SECRET in the n8n server environment.\nManual demo run exercises the same path as scheduled polling.\nError output preserves the execution for operator review.\nHTTP 200 can contain a business failure: inspect PostgreSQL automation runs.\nNever automatically retry uncertain SMTP deliveries.",
        "height": 260,
        "width": 480
      }
    }
  ],
