      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -340
      ],
      "parameters": {
        "content": "## ClientFlow \u00b7 Follow-up stop checks\nThe API owns state, locks, retries, consent and approval.\nSet CLIENTFLOW_API_URL and AUTOMATION_SECRET in the n8n server environment.\nManual demo run exercises the same path as scheduled polling.\nError output preserves the execution for operator review.\nHTTP 200 can contain a business failure: inspect PostgreSQL automation runs.\nNever automatically retry uncertain SMTP deliveries.",
        "height": 260,
        "width": 480
      }
