{
  "id": "clientflow01",
  "name": "ClientFlow \u00b7 Intake orchestration",
  "active": false,
  "nodes": [
    {
      "id": "d1d60286-bcc9-4484-9496-a3bd3fef2b76",
      "name": "Manual demo run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "726d9972-c0ec-4cd2-830d-4e244939c881",
      "name": "Scheduled polling",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        160
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "32909968-ec8c-47b9-9ef6-b2157eb47ac6",
      "name": "Call protected business API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CLIENTFLOW_API_URL + '/automation/pending' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.AUTOMATION_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "aa3976ab-e4db-40ad-9166-cc5e6ffae218",
      "name": "Integration error \u00b7 inspect execution",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        720,
        220
      ],
      "parameters": {
        "errorMessage": "ClientFlow API request failed. Inspect service health and the automation ledger before retrying."
      }
    },
    {
      "id": "d8fc430a-f3a0-4cb4-9f17-521091939d55",
      "name": "One item per pending lead",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "leads",
        "options": {}
      }
    },
    {
      "id": "e9b38cc2-c1c1-4e2f-b523-6a21afa18807",
      "name": "Validate extract score and prepare draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLIENTFLOW_API_URL + '/automation/leads/' + $json.id + '/process' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.AUTOMATION_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "b7437960-8e0a-487f-bbfe-372e03f4407c",
      "name": "Read me \u00b7 no credentials in exports",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -340
      ],
      "parameters": {
        "content": "## ClientFlow \u00b7 Intake orchestration\nThe API owns state, locks, retries, consent and approval.\nSet CLIENTFLOW_API_URL and AUTOMATION_SECRET in the n8n server environment.\nManual demo run exercises the same path as scheduled polling.\nError output preserves the execution for operator review.\nHTTP 200 can contain a business failure: inspect PostgreSQL automation runs.\nNever automatically retry uncertain SMTP deliveries.",
        "height": 260,
        "width": 480
      }
    }
  ],
