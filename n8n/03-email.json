{
  "id": "clientflow03",
  "name": "ClientFlow \u00b7 Approved email delivery",
  "active": false,
  "nodes": [
    {
      "id": "cecf9470-5820-4936-bcec-820eac7bb681",
      "name": "Manual demo run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "6e31652b-2823-41d0-9247-a551cb62b1dd",
      "name": "Scheduled polling",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        160
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "27fd863f-d25d-424a-bc44-a48457d3b8fd",
      "name": "Call protected business API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLIENTFLOW_API_URL + '/automation/email/tick' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.AUTOMATION_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "4e400920-da21-43b4-80c2-6fc0f8e470b6",
      "name": "Integration error \u00b7 inspect execution",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        720,
        220
      ],
      "parameters": {
        "errorMessage": "ClientFlow API request failed. Inspect service health and the automation ledger before retrying."
      }
    },
    {
      "id": "6e4f947d-ab2d-4515-9f76-679e00302fdb",
      "name": "Business outcome recorded in PostgreSQL",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {}
    },
    {
      "id": "c8009b7f-5872-4b08-80b8-be236ca7ff7b",
      "name": "Read me \u00b7 no credentials in exports",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -340
      ],
      "parameters": {
        "content": "## ClientFlow \u00b7 Approved email delivery\nThe API owns state, locks, retries, consent and approval.\nSet CLIENTFLOW_API_URL and AUTOMATION_SECRET in the n8n server environment.\nManual demo run exercises the same path as scheduled polling.\nError output preserves the execution for operator review.\nHTTP 200 can contain a business failure: inspect PostgreSQL automation runs.\nNever automatically retry uncertain SMTP deliveries.",
        "height": 260,
        "width": 480
      }
    }
  ],
