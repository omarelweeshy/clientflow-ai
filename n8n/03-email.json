  "active": false,
  "nodes": [
    {
      "id": "d305c0b7-19a6-4427-aeec-2891761f3ff0",
      "name": "Manual demo run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "77488d17-40b3-4ad0-a99d-f7ef2746290a",
      "name": "Scheduled polling",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        160
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "5e0657ed-2bca-4807-ac9c-fa4a7c35fad9",
      "name": "Call protected business API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CLIENTFLOW_API_URL + '/automation/email/tick' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.AUTOMATION_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 90000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "015c3836-85b8-4009-9ced-af7826db76c0",
      "name": "Integration error \u00b7 inspect execution",
      "type": "n8n-nodes-base.stopAndError",
